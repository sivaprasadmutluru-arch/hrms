    },
    {
      "severity": "high",
      "area": "accounting concurrent initialization",
      "evidence": "Salary Excel request returned HTTP 500 at 50 clients. Server raised CannotAcquireLockException / could not serialize access due to concurrent update in INSERT public.accounting_accounts ... ON CONFLICT DO NOTHING."
    },
    {
      "severity": "high",
      "area": "helpdesk list query amplification",
      "evidence": "Helpdesk list p95 exceeded 12 seconds at 50 clients. Source listTickets loads an unpaginated company list; routingView then reloads each ticket and reads lazy department/employee relationships in separate service transactions."
    },
    {
      "severity": "medium",
      "area": "startup tenant synchronization",
      "evidence": "Sequential synchronization of 30 active tenant schemas took about 6.5 minutes after initial web-server startup. This affects deploy/restart readiness, not the measured warmed-up stages."
    }
